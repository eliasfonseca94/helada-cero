# Plantilla de variables de entorno del frontend (Vite). Copia este archivo a
# ".env" para desarrollo local o ".env.production" para un build de
# producción — ambos quedan fuera de git (ver .gitignore); solo esta
# plantilla se versiona.

# Base de la API del backend (Spring Boot). En desarrollo local, si no se
# define, el cliente HTTP usa http://localhost:8080 por defecto.
VITE_API_BASE_URL=http://localhost:8080
