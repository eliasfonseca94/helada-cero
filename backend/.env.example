# Plantilla de variables de entorno para el perfil "prod".
# Copia este archivo a ".env" (o cárgalas como variables de entorno reales
# del contenedor/servidor) y reemplaza los valores. ".env" está en
# .gitignore: nunca se sube al repositorio, solo esta plantilla sin secretos.

# --- Base de datos PostgreSQL ---
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# --- CORS: dominio(s) exactos desde donde se sirve el frontend ---
# Varios orígenes se separan por coma, sin espacios.
CORS_ALLOWED_ORIGINS=https://tu-frontend-en-produccion.com

# --- Perfil activo ---
SPRING_PROFILES_ACTIVE=prod
